{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gugupang",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // 게임 화면 파일 (index.html, js, css)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 온라인 대결: Lobby(방 목록 + 랭킹) 하나, GameRoom(대결방)은 방마다 하나
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOM", "class_name": "GameRoom" }
    ]
  },
  // 무료 플랜은 SQLite 방식 Durable Object만 쓸 수 있어요.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "GameRoom"] }
  ],
  // 로그: 무료 플랜은 하루 20만 건까지 저장. 대결 중 메시지 하나하나가 로그 1건이라 금방 차서,
  // 10번 중 1번만 저장 (문제가 생기면 같은 에러가 여러 번 나므로 찾는 데는 충분). 게임 동작과는 상관없음
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
